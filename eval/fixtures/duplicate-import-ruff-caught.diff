@@ -0,0 +1,12 @@
+import os
+
+from website_expert.greeting import greeting_prefix
+
+
+def test_greeting_prefix_default(monkeypatch):
+    monkeypatch.delenv("GREETING_PREFIX", raising=False)
+    assert greeting_prefix() == ""
+
+
+def test_greeting_prefix_set(monkeypatch):
+    monkeypatch.setenv("GREETING_PREFIX", ">> ")
+    assert greeting_prefix() == ">> "
